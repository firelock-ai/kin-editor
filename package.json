{
  "name": "kin-editor",
  "displayName": "Kin - The system of record for AI-written software",
  "description": "VS Code extension for Kin, the system of record for AI-written software: entity explorer, semantic search, trace, review, and rename powered by the Kin graph engine.",
  "version": "0.1.5",
  "publisher": "firelock",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Programming Languages",
    "AI",
    "Visualization"
  ],
  "keywords": [
    "kin",
    "semantic",
    "graph",
    "ai",
    "agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/firelock-ai/kin-editor"
  },
  "bugs": {
    "url": "https://github.com/firelock-ai/kin-editor/issues"
  },
  "homepage": "https://kinlab.ai",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0F1117",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kin.setupWorkspace",
        "title": "Kin: Setup Workspace",
        "category": "Kin"
      },
      {
        "command": "kin.search",
        "title": "Kin: Semantic Search",
        "category": "Kin"
      },
      {
        "command": "kin.overview",
        "title": "Kin: Graph Overview",
        "category": "Kin"
      },
      {
        "command": "kin.trace",
        "title": "Kin: Trace Entity",
        "category": "Kin"
      },
      {
        "command": "kin.init",
        "title": "Kin: Initialize Repository",
        "category": "Kin"
      },
      {
        "command": "kin.status",
        "title": "Kin: Show Status",
        "category": "Kin"
      },
      {
        "command": "kin.review",
        "title": "Kin: Review Current File",
        "category": "Kin"
      },
      {
        "command": "kin.refresh",
        "title": "Kin: Refresh Entity Explorer",
        "category": "Kin",
        "icon": "$(refresh)"
      },
      {
        "command": "kin.openWalkthrough",
        "title": "Kin: Start Here",
        "category": "Kin"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kin",
          "title": "Kin",
          "icon": "resources/kin-icon.svg"
        }
      ]
    },
    "views": {
      "kin": [
        {
          "id": "kinExplorer",
          "name": "Entity Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kinExplorer",
        "contents": "Software that remembers itself.\n\nGit shows which lines changed. Kin shows what the change affects. This folder has no Kin graph yet.\n[Build the graph here](command:kin.init)\n[Start here](command:kin.openWalkthrough)\nAlready ran kin init? Check what is wired with [Setup Workspace](command:kin.setupWorkspace).",
        "when": "workspaceFolderCount > 0 && !kin.initialized"
      },
      {
        "view": "kinExplorer",
        "contents": "Kin needs an open folder.\n\nOpen the repository you want to work in, then come back here.\n[Open Folder](command:vscode.openFolder)\n[Start here](command:kin.openWalkthrough)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kin.refresh",
          "when": "view == kinExplorer",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "kin.trace",
          "group": "kin@1",
          "when": "editorTextFocus"
        },
        {
          "command": "kin.search",
          "group": "kin@2",
          "when": "editorTextFocus"
        },
        {
          "command": "kin.review",
          "group": "kin@3",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kin.setupWorkspace",
        "key": "ctrl+shift+k w",
        "mac": "cmd+shift+k w",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "kin.search",
        "key": "ctrl+shift+k s",
        "mac": "cmd+shift+k s",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "kin.trace",
        "key": "ctrl+shift+k t",
        "mac": "cmd+shift+k t",
        "when": "editorTextFocus"
      },
      {
        "command": "kin.overview",
        "key": "ctrl+shift+k o",
        "mac": "cmd+shift+k o",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "kin.refresh",
        "key": "ctrl+shift+k r",
        "mac": "cmd+shift+k r",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "kin.review",
        "key": "ctrl+shift+k v",
        "mac": "cmd+shift+k v",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Kin",
      "properties": {
        "kin.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the kin binary. Leave empty to auto-detect (~/.kin/bin/kin or PATH)."
        },
        "kin.queryTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "How long an interactive Kin query may take before it is treated as a timeout, in milliseconds. A warm semantic query was measured at 11.7 s on one run and 24.0 s on another against the same repository on a loaded host, so the old fixed 15000 sat inside the observed range. Raise this on a large repository or a busy machine."
        },
        "kin.mcpEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Use a persistent MCP connection to the Kin graph for zero-overhead queries. Disable to fall back to one CLI subprocess per command. Hover and go-to-definition run only over MCP and return nothing while it is off."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "kinFirstRun",
        "title": "Software that remembers itself.",
        "description": "Git shows which lines changed. Kin shows what the change affects.",
        "steps": [
          {
            "id": "kin.step.whatKinIs",
            "title": "What Kin is",
            "description": "Kin keeps a living map of the software itself so humans and agents can understand what every change touches. It runs beside Git and it never writes to your `.git`.",
            "media": {
              "markdown": "resources/walkthrough/what-kin-is.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "kin.step.initialize",
            "title": "Build the graph for this repository",
            "description": "`kin init` reads the folder you have open and writes the graph to `.kin/`. The CLI's own output streams into the Kin output channel while it runs.\n[Build the graph here](command:kin.init)",
            "media": {
              "markdown": "resources/walkthrough/initialize.md"
            },
            "completionEvents": [
              "onContext:kin.initialized",
              "onCommand:kin.init"
            ]
          },
          {
            "id": "kin.step.checkInstall",
            "title": "Check what is actually wired",
            "description": "The setup panel runs `kin setup status` and shows every row it reports, with the fix each row carries. The banner is the CLI's own verdict.\n[Open Setup Workspace](command:kin.setupWorkspace)",
            "media": {
              "markdown": "resources/walkthrough/check-install.md"
            },
            "completionEvents": [
              "onCommand:kin.setupWorkspace"
            ]
          },
          {
            "id": "kin.step.findYourWay",
            "title": "Find your way around",
            "description": "The Kin icon in the activity bar opens the Entity Explorer, listed from the graph rather than from a file tree. Search, trace, review and overview all answer from the same graph.\n[Ask the graph a question](command:kin.search)",
            "media": {
              "markdown": "resources/walkthrough/find-your-way.md"
            },
            "completionEvents": [
              "onView:kinExplorer",
              "onCommand:kin.search"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.build.json",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npx @vscode/vsce package",
    "lint": "eslint src",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iarna/toml": "^2.2.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/vscode": "~1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.1",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "ovsx": "^1.1.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6",
    "test-exclude": "^8.0.0"
  }
}
